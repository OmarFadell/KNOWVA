# TeamsFx files
# All per-environment env files are ignored: once provisioned they carry
# real Azure subscription/tenant/resource-group IDs and AAD app client IDs
# (env/.env.dev, env/.env.local, and their .user secret counterparts).
# env/.env.playground is the one exception -- it never gets Azure values
# (m365agents.playground.yml has no provision stage), so it's safe to commit.
env/.env.*
!env/.env.playground
.localConfigs.playground
.localConfigs
.notification.localstore.json
.notification.playgroundstore.json
appPackage/build

# dependencies
node_modules/

# misc
.env
.deployment
.DS_Store

# build
dist/

# Dev tool directories
/devTools/